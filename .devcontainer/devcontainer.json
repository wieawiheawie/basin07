{
  "name": "Deskbound",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh && npm install --no-audit --no-fund",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Deskbound",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  }
}
